{
  "name": "words-learning",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:buildDebug": "yarn react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res; cd android; ./gradlew assembleDebug",
    "android:bundle": "react-native bundle --platform android --dev false --entry-file index.android.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "android:build": "cd android && ./gradlew assembleRelease && cd ..",
    "android:install": "adb -d install android/app/build/outputs/apk/release/app-release.apk",
    "build:ios": "react-native bundle --entry-file='App.tsx' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'",
    "refreshNodeModules": "rm -rf node_modules && yarn",
    "refreshPods": "cd ios && rm -rf Pods && pod install && cd ..",
    "refreshAllDeps": "yarn refreshNodeModules && yarn refreshPods",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "dict:fetch": "node scripts/dictionary/fetch.ts",
    "dict:build": "node --max-old-space-size=4096 scripts/dictionary/build.ts",
    "brand": "node scripts/brand/generate.ts",
    "android:release": "node scripts/android-release.ts"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.4",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-native-documents/picker": "^12.0.3",
    "@react-native/new-app-screen": "0.88.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-bootsplash": "^7.3.4",
    "react-native-gesture-handler": "^2.33.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-reorderable-list": "^0.18.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.16.0",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
