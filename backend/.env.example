# HTTP port of the API.
PORT=3000
# PostgreSQL connection (docker-compose.yml starts one with these values).
DATABASE_URL=postgres://words:words@localhost:5432/words
# Max request body; a first sync uploads every word of the phone at once.
BODY_LIMIT=50mb
# Folder with the <lang>-ru.db dictionaries the app downloads and the website
# looks words up in. Default: dictionaries/ in the app root.
# DICTIONARIES_DIR=/home/<cpuser>/words-api/dictionaries
